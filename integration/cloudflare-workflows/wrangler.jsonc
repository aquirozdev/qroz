{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "qroz-cloudflare-workflows-integration",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-19",
  "workflows": [
    {
      "name": "qroz-welcome-workflow",
      "binding": "ARC_WELCOME",
      "class_name": "ArcWelcomeWorkflow"
    }
  ]
}
