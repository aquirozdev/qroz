{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qroz-idempotency-integration",
  "main": "src/idempotency-integration-worker.ts",
  "compatibility_date": "2026-09-18",
  "durable_objects": {
    "bindings": [
      {
        "name": "IDEMPOTENCY",
        "class_name": "ArcIdempotencyDurableObject"
      }
    ]
  },
  "exports": {
    "ArcIdempotencyDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
