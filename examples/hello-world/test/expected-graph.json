{
  "schemaVersion": 4,
  "name": "example",
  "capabilities": [
    {
      "name": "users.repository",
      "configured": true
    },
    {
      "name": "audit.sink",
      "configured": true
    },
    {
      "name": "storage.files",
      "configured": true,
      "kind": "resource",
      "resourceType": "object-storage",
      "features": [
        "get",
        "head",
        "put",
        "delete",
        "streaming"
      ],
      "operations": [
        "read",
        "write",
        "delete"
      ]
    },
    {
      "name": "queue.notifications",
      "configured": true,
      "kind": "resource",
      "resourceType": "message-queue",
      "features": [
        "send",
        "delay"
      ],
      "operations": [
        "publish"
      ]
    },
    {
      "name": "queue.jobs.notifications",
      "configured": true,
      "kind": "resource",
      "resourceType": "message-queue",
      "features": [
        "send",
        "delay"
      ],
      "operations": [
        "publish"
      ]
    },
    {
      "name": "jobs.notifications.idempotency",
      "configured": true,
      "kind": "resource",
      "resourceType": "idempotency-store",
      "features": [
        "atomic-claim",
        "lease",
        "completion"
      ],
      "operations": [
        "claim",
        "complete",
        "release"
      ]
    },
    {
      "name": "notifications.delivery",
      "configured": true
    }
  ],
  "providers": [
    {
      "capability": "users.repository"
    },
    {
      "capability": "audit.sink"
    },
    {
      "capability": "storage.files"
    },
    {
      "capability": "queue.notifications"
    },
    {
      "capability": "queue.jobs.notifications"
    },
    {
      "capability": "jobs.notifications.idempotency"
    },
    {
      "capability": "notifications.delivery"
    }
  ],
  "modules": [
    {
      "name": "users",
      "endpoints": [
        {
          "name": "getUser",
          "method": "GET",
          "path": "/users/:id",
          "status": 200,
          "requires": [
            "users.repository"
          ],
          "emits": [],
          "dispatches": [],
          "hasParamsSchema": true,
          "hasBodySchema": false,
          "hasQuerySchema": false,
          "hasOutputSchema": true,
          "access": []
        },
        {
          "name": "createUser",
          "method": "POST",
          "path": "/users",
          "status": 201,
          "requires": [
            "users.repository"
          ],
          "emits": [
            {
              "event": "user.created",
              "version": 1
            }
          ],
          "dispatches": [],
          "hasParamsSchema": false,
          "hasBodySchema": true,
          "hasQuerySchema": false,
          "hasOutputSchema": true,
          "access": []
        },
        {
          "name": "searchUsers",
          "method": "GET",
          "path": "/users",
          "status": 200,
          "requires": [
            "users.repository"
          ],
          "emits": [],
          "dispatches": [],
          "hasParamsSchema": false,
          "hasBodySchema": false,
          "hasQuerySchema": true,
          "hasOutputSchema": true,
          "access": []
        }
      ],
      "listeners": [
        {
          "name": "auditUserCreated",
          "event": "user.created",
          "version": 1,
          "requires": [
            "audit.sink"
          ],
          "emits": [],
          "dispatches": [],
          "access": []
        }
      ],
      "jobs": []
    },
    {
      "name": "files",
      "endpoints": [
        {
          "name": "putFile",
          "method": "POST",
          "path": "/files",
          "status": 201,
          "requires": [
            "storage.files"
          ],
          "emits": [],
          "dispatches": [],
          "hasParamsSchema": false,
          "hasBodySchema": true,
          "hasQuerySchema": false,
          "hasOutputSchema": true,
          "access": [
            {
              "capability": "storage.files",
              "operations": [
                "write"
              ]
            }
          ]
        },
        {
          "name": "getFile",
          "method": "GET",
          "path": "/files/:key",
          "status": 200,
          "requires": [
            "storage.files"
          ],
          "emits": [],
          "dispatches": [],
          "hasParamsSchema": true,
          "hasBodySchema": false,
          "hasQuerySchema": false,
          "hasOutputSchema": true,
          "access": [
            {
              "capability": "storage.files",
              "operations": [
                "read"
              ]
            }
          ]
        }
      ],
      "listeners": [],
      "jobs": []
    },
    {
      "name": "notifications",
      "endpoints": [
        {
          "name": "enqueueNotification",
          "method": "POST",
          "path": "/notifications",
          "status": 200,
          "requires": [
            "queue.notifications"
          ],
          "emits": [],
          "dispatches": [],
          "hasParamsSchema": false,
          "hasBodySchema": true,
          "hasQuerySchema": false,
          "hasOutputSchema": true,
          "access": [
            {
              "capability": "queue.notifications",
              "operations": [
                "publish"
              ]
            }
          ]
        },
        {
          "name": "dispatchNotification",
          "method": "POST",
          "path": "/notification-jobs",
          "status": 200,
          "requires": [],
          "emits": [],
          "dispatches": [
            {
              "job": "notifications.deliver",
              "version": 1
            }
          ],
          "hasParamsSchema": false,
          "hasBodySchema": true,
          "hasQuerySchema": false,
          "hasOutputSchema": true,
          "access": []
        }
      ],
      "listeners": [],
      "jobs": [
        {
          "name": "DeliverNotification",
          "job": "notifications.deliver",
          "version": 1,
          "transport": "queue.jobs.notifications",
          "requires": [
            "notifications.delivery"
          ],
          "retry": {
            "strategy": "exponential",
            "delaySeconds": 5,
            "maxDelaySeconds": 60
          },
          "idempotency": {
            "store": "jobs.notifications.idempotency",
            "leaseSeconds": 30,
            "ttlSeconds": 86400
          },
          "hasInputSchema": true,
          "access": []
        }
      ]
    }
  ]
}
